-- ============================================================
-- Song Example (section-oriented) — 128 bars, ABABCAB + outro
-- 4 tracks: drums, bass, chords, lead
-- Each section step = 1 bar (4 beats)
-- ============================================================
--
-- Structure:
--   intro    × 8  →   8 bars  (entry, sparse)
--   verse    ×16  →  16 bars  (A)
--   chorus   ×16  →  16 bars  (B)
--   verse    ×16  →  16 bars  (A)
--   chorus   ×16  →  16 bars  (B)
--   bridge   ×16  →  16 bars  (C)
--   verse    ×16  →  16 bars  (A)
--   chorus   ×16  →  16 bars  (B)
--   outro    × 8  →   8 bars  (fade)
--                    -------
--                    128 bars total

let intro = section {
  drums:  stack [
            s "bd ~ ~ ~",
            s "hh ~ hh ~"
          ],
  bass:   n "c2 ~ ~ ~" # s "bass",
  chords: stack [
            n "c3 ~ ~ ~" # s "pad",
            n "e3 ~ ~ ~" # s "pad",
            n "g3 ~ ~ ~" # s "pad"
          ]
  -- lead omitted: silent during intro
}

let verse = section {
  drums:  stack [
            s "bd ~ cp ~ bd ~ cp ~",
            s "hh*8",
            s "oh ~ ~ ~ oh ~ ~ ~"
          ],
  bass:   n "c2 ~ g2 ~ f2 ~ g2 ~" # s "bass",
  chords: stack [
            n "c3 ~ a2 ~ f2 ~ g2 ~" # s "pad",
            n "e3 ~ c3 ~ a2 ~ b2 ~" # s "pad",
            n "g3 ~ e3 ~ c3 ~ d3 ~" # s "pad"
          ],
  lead:   n "c4 ~ e4 ~ g4 ~ e4 ~" # s "lead"
}

let chorus = section {
  drums:  stack [
            s "bd cp bd cp",
            s "[hh hh]*4",
            s "oh ~ oh ~ oh ~ oh ~",
            s "crash!8"             -- crash cymbal every 8th bar
          ],
  bass:   n "c2 e2 g2 e2 f2 a2 g2 ~" # s "bass",
  chords: stack [
            n "c3 c3 f2 ~ g2 ~ c3 ~" # s "keys",
            n "e3 e3 a2 ~ b2 ~ e3 ~" # s "keys",
            n "g3 g3 c3 ~ d3 ~ g3 ~" # s "keys"
          ],
  lead:   n "c5 b4 a4 g4 e4 ~ c4 e4" # s "lead"
}

let bridge = section {
  drums:  stack [
            s "bd ~ ~ cp ~ ~ bd ~",  -- half-time snare feel
            s "hh ~ hh hh ~ hh hh ~",
            s "oh!4"                  -- open hat every 4th bar
          ],
  bass:   n "a1 ~ e2 ~ f1 ~ c2 g1" # s "bass",
  chords: stack [
            n "a2 ~ f2 ~ c3 ~ g2 ~" # s "pad",
            n "c3 ~ a2 ~ e3 ~ b2 ~" # s "pad",
            n "e3 ~ c3 ~ g3 ~ d3 ~" # s "pad"
          ],
  lead:   n "a4 ~ g4 f4 e4 ~ d4 ~" # s "lead"
}

let outro = section {
  drums:  stack [
            s "bd ~ ~ ~",
            s "hh ~ hh ~",
            s "crash!1"              -- crash on the very first outro bar only
          ],
  bass:   n "c2 ~ ~ ~" # s "bass",
  chords: stack [
            n "c3 ~ ~ ~" # s "pad",
            n "e3 ~ ~ ~" # s "pad",
            n "g3 ~ ~ ~" # s "pad"
          ],
  lead:   n "c4 ~ ~ ~" # s "lead"
}

-- ── Arrangement ───────────────────────────────────────────────

song [ intro.8 verse.16 chorus.16 verse.16 chorus.16 bridge.16 verse.16 chorus.16 outro.8 ]
